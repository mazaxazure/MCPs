<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Planning_MCP</RootNamespace>
    <AssemblyName>Planning_MCP</AssemblyName>
    <Title>Planning MCP Server</Title>
    <Description>A Model Context Protocol server for task planning, document parsing, and sprint scheduling</Description>
    <Version>1.0.0</Version>
    <Authors>Sergio Cabello Pacha</Authors>
    
    <!-- NuGet Package Settings -->
    <PackageId>Planning_MCP</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>planning-mcp-server</ToolCommandName>
    <PackageType>mcpserver</PackageType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/mazaxazure/MCPs</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>mcp;planning;tasks;sprints;documents;model-context-protocol</PackageTags>
    
    <!-- Runtime Identifiers for multi-platform support -->
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    
    <!-- Document parsing packages -->
    <PackageReference Include="PdfPig" Version="0.1.9" />
    <PackageReference Include="DocX" Version="3.0.1" />
    <PackageReference Include="Markdig" Version="0.37.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
